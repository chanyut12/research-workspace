                "type": "string"
              }
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "G3": {
          "type": "object",
          "required": [
            "approved",
            "approved_ids"
          ],
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "approved_at": {
              "type": [
                "string",
