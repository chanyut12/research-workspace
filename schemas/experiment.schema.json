{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "experiment",
  "type": "object",
  "required": [
    "id",
    "hypothesis_id",
    "objective",
    "dataset",
    "split",
    "metrics",
    "primary_metric",
    "seeds",
    "analysis_plan",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^X-\\d{3,}$"
    },
    "hypothesis_id": {
      "type": "string",
      "pattern": "^H-\\d{3,}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "required": [
        "name",
        "version",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        }
      }
    },
    "split": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1
    },
    "analysis_plan": {
      "type": "string",
      "minLength": 1
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "running",
        "done"
      ]
    }
  }
}
