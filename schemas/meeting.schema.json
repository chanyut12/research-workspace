{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meeting",
  "type": "object",
  "required": [
    "id",
    "type",
    "date",
    "participants",
    "agenda",
    "prep_questions",
    "logged"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^M-\\d{3,}$"
    },
    "type": {
      "enum": [
        "expert-consult",
        "advisor-review",
        "self-note"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "minItems": 1
    },
    "agenda": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prep_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "transcript_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "logged": {
      "type": "boolean"
    }
  }
}
