{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decision",
  "type": "object",
  "required": [
    "timestamp",
    "kind"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "init",
        "advance",
        "approve",
        "amend",
        "note"
      ]
    },
    "from": {
      "type": [
        "string",
        "null"
      ]
    },
    "to": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate": {
      "type": [
        "string",
        "null"
      ]
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "cause_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
